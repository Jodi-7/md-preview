{
  "name": "md-preview",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "一个快速、准确的本地 Markdown 预览器",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "electron .",
    "dist": "pnpm build && node scripts/package-desktop.mjs",
    "scan": "node tools/scan-secrets.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^40.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
